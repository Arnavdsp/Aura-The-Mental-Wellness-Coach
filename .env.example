# Copy to .env and change what you need. Every value below is the default from
# src/aura/config.py, so an empty .env behaves the same as this file.

# -- service -------------------------------------------------------------
AURA_ENVIRONMENT=development        # development | staging | production
AURA_HOST=0.0.0.0
AURA_PORT=8000
AURA_LOG_LEVEL=INFO
AURA_LOG_JSON=false
# JSON list, e.g. ["https://aura.example.com"]
AURA_CORS_ORIGINS=["*"]

# -- engine --------------------------------------------------------------
AURA_ENGINE=auto                    # auto | gemma | echo (auto falls back to echo without a GPU)
AURA_MODEL_ID=unsloth/gemma-3n-E2B-it   # unsloth/gemma-3n-E4B-it for the larger variant
# AURA_ADAPTER_PATH=var/adapters/aura-lora   # LoRA adapter written by `aura train`
AURA_LOAD_IN_4BIT=true
AURA_MAX_SEQ_LENGTH=4096
AURA_MAX_NEW_TOKENS=512
AURA_TEMPERATURE=0.7
AURA_TOP_P=0.95
AURA_TOP_K=64
AURA_REPETITION_PENALTY=1.05
# AURA_DEVICE=cuda                  # unset: cuda if available, else cpu

# -- modalities ----------------------------------------------------------
AURA_ENABLE_VISION=true
AURA_ENABLE_AUDIO_INPUT=true
AURA_ENABLE_AUDIO_OUTPUT=true
AURA_TTS_BACKEND=speecht5           # speecht5 | piper | none
AURA_TTS_MODEL_ID=microsoft/speecht5_tts
AURA_TTS_VOCODER_ID=microsoft/speecht5_hifigan
AURA_TTS_SPEAKER_INDEX=7306
AURA_ASR_BACKEND=gemma              # gemma | whisper | none
AURA_ASR_MODEL_ID=openai/whisper-small
AURA_AUDIO_SAMPLE_RATE=16000
AURA_MAX_UPLOAD_BYTES=26214400      # 25 MB

# -- affect --------------------------------------------------------------
AURA_ENABLE_SPEECH_EMOTION=false    # needs an extra wav2vec2 model and adds latency
AURA_SPEECH_EMOTION_MODEL_ID=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition

# -- sessions ------------------------------------------------------------
AURA_SESSION_TTL_SECONDS=21600      # 6 hours
AURA_MAX_TURNS_IN_CONTEXT=12
AURA_MAX_SESSIONS=2000

# -- safety --------------------------------------------------------------
AURA_SAFETY_ENABLED=true
AURA_CRISIS_REGION=INTL             # US | IN | UK | INTL

# -- paths ---------------------------------------------------------------
# AURA_STATIC_DIR=web               # set to public/ on Vercel (api/index.py does this)
# AURA_DATA_DIR=var
