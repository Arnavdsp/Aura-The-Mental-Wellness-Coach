{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "true",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/assets/:match*",
      "destination": "/:match*"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}